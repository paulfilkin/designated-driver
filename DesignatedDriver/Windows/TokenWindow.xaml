<Window x:Class="DesignatedDriver.Windows.TokenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DesignatedDriver.Resources"
        Title="{x:Static res:Strings.Token_Title}"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="28,24,28,20">
        <TextBlock Text="{x:Static res:Strings.Token_Title}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{x:Static res:Strings.Token_Intro}" Style="{StaticResource PageIntro}"/>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Token_How}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Button Content="{x:Static res:Strings.Token_OpenGitHub}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="OpenGitHub_Click"
                        AutomationProperties.Name="{x:Static res:Strings.Token_OpenGitHubHelp}"/>
                <TextBlock Text="{x:Static res:Strings.Token_Label}" Style="{StaticResource LabelText}" Margin="0,12,0,4"/>
                <PasswordBox x:Name="TokenBox" Padding="8,6" FontFamily="Consolas" PasswordChanged="TokenBox_PasswordChanged"
                             AutomationProperties.Name="{x:Static res:Strings.Token_Label}" AutomationProperties.HelpText="{x:Static res:Strings.Token_Help}"/>
                <TextBlock Text="{x:Static res:Strings.Token_Help}" Style="{StaticResource HelperText}"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="{x:Static res:Strings.Common_Cancel}" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0"
                    AutomationProperties.Name="{x:Static res:Strings.Common_Cancel}"/>
            <Button x:Name="UseButton" Content="{x:Static res:Strings.Token_Use}" Style="{StaticResource ModernButton}" IsDefault="True" IsEnabled="False" Click="Use_Click"
                    AutomationProperties.Name="{x:Static res:Strings.Token_Use}"/>
        </StackPanel>
    </StackPanel>
</Window>
