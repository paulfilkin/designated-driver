<Window x:Class="DesignatedDriver.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DesignatedDriver.Resources"
        Title="{x:Static res:Strings.About_Title}"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="32,28,32,24">
        <Image Source="/icon.png" Width="96" Height="96" Margin="0,0,0,14" AutomationProperties.Name="{x:Static res:Strings.App_Name}"/>
        <TextBlock Text="{x:Static res:Strings.App_Name}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TertiaryBrush}" HorizontalAlignment="Center"/>
        <TextBlock x:Name="VersionText" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,20"/>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.About_PurposeHeader}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{x:Static res:Strings.App_Description}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border x:Name="LinksCard" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.About_LinksHeader}" Style="{StaticResource CardTitle}"/>
                <TextBlock Margin="0,0,0,6">
                    <Hyperlink x:Name="RepositoryLink" RequestNavigate="Link_RequestNavigate" AutomationProperties.Name="{x:Static res:Strings.About_RepositoryLink}">
                        <Run Text="{x:Static res:Strings.About_RepositoryLink}"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,0,0,6">
                    <Hyperlink x:Name="ContributingLink" RequestNavigate="Link_RequestNavigate" AutomationProperties.Name="{x:Static res:Strings.About_ContributingLink}">
                        <Run Text="{x:Static res:Strings.About_ContributingLink}"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock x:Name="BoardLine">
                    <Hyperlink x:Name="BoardLink" RequestNavigate="Link_RequestNavigate" AutomationProperties.Name="{x:Static res:Strings.About_BoardLink}">
                        <Run Text="{x:Static res:Strings.About_BoardLink}"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock x:Name="CopyrightText" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,16"/>
        <Button Content="{x:Static res:Strings.Common_Close}" Style="{StaticResource ModernButton}" HorizontalAlignment="Center" MinWidth="120" Margin="0" IsCancel="True" IsDefault="True"
                AutomationProperties.Name="{x:Static res:Strings.Common_Close}"/>
    </StackPanel>
</Window>
