<Window x:Class="DesignatedDriver.Windows.TextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DesignatedDriver.Resources"
        Width="900" Height="640" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" Style="{StaticResource CardTitle}"/>
        <TextBox x:Name="BodyText" Grid.Row="1" IsReadOnly="True" Style="{StaticResource MonoTextBox}" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="{x:Static res:Strings.Diff_ContentName}"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static res:Strings.Activity_Copy}" Style="{StaticResource SecondaryButton}" Click="Copy_Click" AutomationProperties.Name="{x:Static res:Strings.Diff_CopyHelp}"/>
            <Button Content="{x:Static res:Strings.Common_Close}" Style="{StaticResource ModernButton}" IsCancel="True" IsDefault="True" Margin="0" MinWidth="100" AutomationProperties.Name="{x:Static res:Strings.Common_Close}"/>
        </StackPanel>
    </Grid>
</Window>
