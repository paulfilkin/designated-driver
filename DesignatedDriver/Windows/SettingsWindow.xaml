<Window x:Class="DesignatedDriver.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DesignatedDriver.Resources"
        Title="{x:Static res:Strings.Settings_Title}"
        Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <!-- The content scrolls and Save and Cancel stay below it: the window is capped at the screen's height in code. -->
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel>
        <TextBlock x:Name="TitleText" Text="{x:Static res:Strings.Settings_Title}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{x:Static res:Strings.Settings_Intro}" Style="{StaticResource PageIntro}"/>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Settings_RepositoryFolder}" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Style="{StaticResource ModernTextBox}" TextChanged="FolderBox_TextChanged"
                             AutomationProperties.Name="{x:Static res:Strings.Settings_RepositoryFolder}" AutomationProperties.HelpText="{x:Static res:Strings.Settings_RepositoryFolderHelp}"/>
                    <Button Grid.Column="1" Content="{x:Static res:Strings.Settings_Browse}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Browse_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Settings_BrowseHelp}"/>
                </Grid>
                <TextBlock x:Name="FolderNote" Style="{StaticResource HelperText}"/>
                <TextBlock Text="{x:Static res:Strings.Settings_RepositoryFolderHelp}" Style="{StaticResource HelperText}"/>

                <TextBlock Text="{x:Static res:Strings.Settings_OwnerAndRepository}" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="OwnerRepoBox" Style="{StaticResource ModernTextBox}" IsReadOnly="True"
                         AutomationProperties.Name="{x:Static res:Strings.Settings_OwnerAndRepository}" AutomationProperties.HelpText="{x:Static res:Strings.Settings_OwnerAndRepositoryHelp}"/>
                <TextBlock Text="{x:Static res:Strings.Settings_OwnerAndRepositoryHelp}" Style="{StaticResource HelperText}"/>
                <TextBlock x:Name="KnownNote" Style="{StaticResource HelperText}" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <!-- A repository without a manifest can have what it already uses read from GitHub; nothing is saved until Save. -->
                <StackPanel x:Name="ReadPanel" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ReadButton" Content="{x:Static res:Strings.Settings_ReadFromGitHub}" Style="{StaticResource SecondaryButton}" Click="Read_Click"
                                AutomationProperties.Name="{x:Static res:Strings.Settings_ReadFromGitHub}" AutomationProperties.HelpText="{x:Static res:Strings.Settings_ReadFromGitHubHelp}"/>
                    </StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Settings_ReadFromGitHubHelp}" Style="{StaticResource HelperText}"/>
                    <TextBlock x:Name="ReadNote" Style="{StaticResource HelperText}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static res:Strings.Settings_ProjectOwner}" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ProjectOwnerBox" Style="{StaticResource ModernTextBox}" AutomationProperties.Name="{x:Static res:Strings.Settings_ProjectOwner}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Static res:Strings.Settings_ProjectNumber}" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ProjectNumberBox" Style="{StaticResource ModernTextBox}" AutomationProperties.Name="{x:Static res:Strings.Settings_ProjectNumber}"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ProjectHelp" Text="{x:Static res:Strings.Settings_ProjectHelp}" Style="{StaticResource HelperText}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static res:Strings.Settings_ReadyColumn}" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="ReadyColumnBox" Style="{StaticResource ModernTextBox}" AutomationProperties.Name="{x:Static res:Strings.Settings_ReadyColumn}" AutomationProperties.HelpText="{x:Static res:Strings.Settings_ColumnsHelp}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Static res:Strings.Settings_InProgressColumn}" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="InProgressColumnBox" Style="{StaticResource ModernTextBox}" AutomationProperties.Name="{x:Static res:Strings.Settings_InProgressColumn}" AutomationProperties.HelpText="{x:Static res:Strings.Settings_ColumnsHelp}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{x:Static res:Strings.Settings_InReviewColumn}" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="InReviewColumnBox" Style="{StaticResource ModernTextBox}" AutomationProperties.Name="{x:Static res:Strings.Settings_InReviewColumn}" AutomationProperties.HelpText="{x:Static res:Strings.Settings_ColumnsHelp}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{x:Static res:Strings.Settings_ColumnsHelp}" Style="{StaticResource HelperText}"/>

                <TextBlock Text="{x:Static res:Strings.Settings_DefaultBranch}" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="DefaultBranchBox" Style="{StaticResource ModernTextBox}" Width="200" HorizontalAlignment="Left" AutomationProperties.Name="{x:Static res:Strings.Settings_DefaultBranch}"/>

                <TextBlock Text="{x:Static res:Strings.Settings_SelfTestCommand}" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="SelfTestBox" Style="{StaticResource ModernTextBox}" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                         AutomationProperties.Name="{x:Static res:Strings.Settings_SelfTestCommand}" AutomationProperties.HelpText="{x:Static res:Strings.Settings_SelfTestHelp}"/>
                <TextBlock Text="{x:Static res:Strings.Settings_SelfTestHelp}" Style="{StaticResource HelperText}"/>

                <TextBlock Text="{x:Static res:Strings.Settings_RequiredCheck}" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="RequiredCheckBox" Style="{StaticResource ModernTextBox}" Width="300" HorizontalAlignment="Left" AutomationProperties.Name="{x:Static res:Strings.Settings_RequiredCheck}"/>
                <TextBlock Text="{x:Static res:Strings.Settings_RequiredCheckHelp}" Style="{StaticResource HelperText}"/>

                <CheckBox x:Name="KeepsOwnBox" Content="{x:Static res:Strings.Settings_KeepsOwnConventions}" Margin="0,12,0,0"
                          AutomationProperties.Name="{x:Static res:Strings.Settings_KeepsOwnConventions}" AutomationProperties.HelpText="{x:Static res:Strings.Settings_KeepsOwnConventionsHelp}"/>
                <TextBlock Text="{x:Static res:Strings.Settings_KeepsOwnConventionsHelp}" Style="{StaticResource HelperText}" Margin="24,2,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StoredAtText" Style="{StaticResource HelperText}" Margin="0,0,0,14"/>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{x:Static res:Strings.Common_Cancel}" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="100" AutomationProperties.Name="{x:Static res:Strings.Common_Cancel}"/>
            <Button x:Name="SaveButton" Content="{x:Static res:Strings.Common_Save}" Style="{StaticResource ModernButton}" IsDefault="True" MinWidth="100" Margin="0" Click="Save_Click"
                    AutomationProperties.Name="{x:Static res:Strings.Common_Save}"/>
        </StackPanel>
    </Grid>
</Window>
