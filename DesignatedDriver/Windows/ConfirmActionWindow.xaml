<Window x:Class="DesignatedDriver.Windows.ConfirmActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DesignatedDriver.Resources"
        Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel>
        <!-- The repository, large and in colour across the top, so it can't be missed whatever else goes unread. -->
        <Border Background="{StaticResource PrimaryStrongBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="0,0,0,3" Padding="28,18,28,16">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Confirm_Repository}" Foreground="White" Opacity="0.85" FontSize="13"/>
                <TextBlock x:Name="RepositoryText" Foreground="White" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="RepositoryNote" Foreground="White" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="28,18,28,20">
            <TextBlock x:Name="ActionText" FontSize="15" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>

            <!-- For a merge: the repository's name typed before the button enables, unless its settings say otherwise. -->
            <StackPanel x:Name="TypePanel" Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock x:Name="TypeLabel" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="TypeBox" Style="{StaticResource ModernTextBox}" FontFamily="Cascadia Mono, Consolas" TextChanged="TypeBox_TextChanged"
                         AutomationProperties.HelpText="{x:Static res:Strings.Confirm_TypeHelp}"/>
                <TextBlock Text="{x:Static res:Strings.Confirm_TypeHelp}" Style="{StaticResource HelperText}"/>
            </StackPanel>

            <!-- No default button: Enter alone never confirms. Cancel, or the typing box, has the focus. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="{x:Static res:Strings.Common_Cancel}" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0"
                        AutomationProperties.Name="{x:Static res:Strings.Common_Cancel}"/>
                <Button x:Name="ConfirmButton" Style="{StaticResource ModernButton}" Click="Confirm_Click"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
