<Window x:Class="DesignatedDriver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DesignatedDriver.Resources"
        Title="{x:Static res:Strings.App_Name}"
        Width="1180" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="Manual"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200" MinHeight="60"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="icon.png" Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center"
                       AutomationProperties.Name="{x:Static res:Strings.App_Name}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static res:Strings.App_Name}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TertiaryBrush}"/>
                    <TextBlock Text="{x:Static res:Strings.App_Tagline}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"/>
                </StackPanel>

                <!-- Repository switcher -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{x:Static res:Strings.Header_Repository}" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="RepositoryPicker" MinWidth="240" VerticalAlignment="Center" SelectionChanged="RepositoryPicker_SelectionChanged"
                              AutomationProperties.Name="{x:Static res:Strings.Header_Repository}" AutomationProperties.HelpText="{x:Static res:Strings.Header_SwitchHelp}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="UserChip" Style="{StaticResource TagBorder}" Background="{StaticResource PrimarySofterBrush}" Padding="10,4" Margin="0,0,12,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UserText" Style="{StaticResource TagText}" Foreground="{StaticResource TertiaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="RoleText" Style="{StaticResource TagText}" Foreground="{StaticResource TertiaryBrush}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="SettingsButton" Content="{x:Static res:Strings.Menu_Settings}" Style="{StaticResource SecondaryButton}" Click="SettingsButton_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Menu_Settings}" AutomationProperties.HelpText="{x:Static res:Strings.Menu_SettingsHelp}"/>
                    <Button x:Name="AboutButton" Content="{x:Static res:Strings.Menu_About}" Style="{StaticResource SecondaryButton}" Click="AboutButton_Click" Margin="0"
                            AutomationProperties.Name="{x:Static res:Strings.Menu_About}" AutomationProperties.HelpText="{x:Static res:Strings.Menu_AboutHelp}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Busy strip -->
        <Border x:Name="BusyStrip" Grid.Row="1" Background="{StaticResource PrimarySofterBrush}" Padding="18,6" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BusyText" Grid.Column="0" Text="{x:Static res:Strings.Busy_Working}" Foreground="{StaticResource TertiaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"
                           FontFamily="Cascadia Mono, Consolas" AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar Grid.Column="1" IsIndeterminate="True" VerticalAlignment="Center" AutomationProperties.Name="{x:Static res:Strings.Busy_Working}"/>
                <Button Grid.Column="2" Content="{x:Static res:Strings.Common_Cancel}" Style="{StaticResource LinkButton}" Margin="12,0,0,0" Click="CancelButton_Click"
                        AutomationProperties.Name="{x:Static res:Strings.Busy_CancelHelp}"/>
            </Grid>
        </Border>

        <!-- Navigation and content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="10,14">
                <StackPanel x:Name="NavPanel" AutomationProperties.Name="{x:Static res:Strings.Nav_Name}"/>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20,24,8">
                <ContentControl x:Name="ScreenHost" Focusable="False"/>
            </ScrollViewer>
        </Grid>

        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" ResizeBehavior="PreviousAndNext"
                      AutomationProperties.Name="{x:Static res:Strings.Activity_Splitter}"/>

        <!-- Activity panel: every command the tool runs and its output -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="18,6,18,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Activity_Title}" FontWeight="SemiBold" Foreground="{StaticResource TertiaryBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="{x:Static res:Strings.Activity_Copy}" Style="{StaticResource LinkButton}" Click="CopyActivity_Click" Margin="0,0,12,0"
                            AutomationProperties.Name="{x:Static res:Strings.Activity_CopyHelp}"/>
                    <Button Grid.Column="2" Content="{x:Static res:Strings.Activity_Clear}" Style="{StaticResource LinkButton}" Click="ClearActivity_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Activity_ClearHelp}"/>
                </Grid>
                <TextBox x:Name="ActivityText" Grid.Row="1" Margin="18,0,18,10" IsReadOnly="True" Style="{StaticResource MonoTextBox}"
                         Background="{StaticResource NeutralSoftestBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         AutomationProperties.Name="{x:Static res:Strings.Activity_Title}" AutomationProperties.HelpText="{x:Static res:Strings.Activity_Help}"
                         AutomationProperties.LiveSetting="Polite"/>
            </Grid>
        </Border>
    </Grid>
</Window>
