<local:ScreenBase x:Class="DesignatedDriver.Screens.SubmitScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesignatedDriver.Screens"
        xmlns:res="clr-namespace:DesignatedDriver.Resources">
    <StackPanel MaxWidth="980" HorizontalAlignment="Left">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Submit_Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{x:Static res:Strings.Submit_Intro}" Style="{StaticResource PageIntro}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{x:Static res:Strings.Common_Refresh}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Margin="12,4,0,0" Click="Refresh_Click"
                    AutomationProperties.Name="{x:Static res:Strings.Common_Refresh}"/>
        </Grid>

        <Border x:Name="OnMainNotice" Style="{StaticResource WarningNoticeStyle}" Visibility="Collapsed">
            <TextBlock x:Name="OnMainText"/>
        </Border>

        <Border x:Name="ExistingNotice" Style="{StaticResource SuccessNoticeStyle}" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ExistingText" VerticalAlignment="Center"/>
                <Button x:Name="ExistingLink" Content="{x:Static res:Strings.Common_OpenOnGitHub}" Style="{StaticResource LinkButton}" Margin="10,0,0,0" Click="OpenExisting_Click"
                        AutomationProperties.Name="{x:Static res:Strings.Common_OpenOnGitHub}"/>
            </StackPanel>
        </Border>

        <Border x:Name="CreateCard" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Submit_PullRequest}" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="BranchLine" Style="{StaticResource HelperText}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Submit_IssueNumber}" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="IssueBox" Style="{StaticResource ModernTextBox}" TextChanged="IssueBox_TextChanged"
                                 AutomationProperties.Name="{x:Static res:Strings.Submit_IssueNumber}" AutomationProperties.HelpText="{x:Static res:Strings.Submit_IssueNumberHelp}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:Strings.Submit_PullRequestTitle}" Style="{StaticResource LabelText}"/>
                            <Button Grid.Column="1" Content="{x:Static res:Strings.Submit_UseIssueTitle}" Style="{StaticResource LinkButton}" VerticalAlignment="Bottom" Margin="0,0,0,4" Click="UseIssueTitle_Click"
                                    AutomationProperties.Name="{x:Static res:Strings.Submit_UseIssueTitle}"/>
                        </Grid>
                        <TextBox x:Name="TitleBox" Style="{StaticResource ModernTextBox}" TextChanged="TitleBox_TextChanged"
                                 AutomationProperties.Name="{x:Static res:Strings.Submit_PullRequestTitle}"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="IssueNote" Style="{StaticResource HelperText}"/>

                <TextBlock Text="{x:Static res:Strings.Submit_Body}" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="BodyBox" Style="{StaticResource MonoTextBox}" Height="280"
                         AutomationProperties.Name="{x:Static res:Strings.Submit_Body}" AutomationProperties.HelpText="{x:Static res:Strings.Submit_BodyHelp}"/>
                <TextBlock Text="{x:Static res:Strings.Submit_BodyHelp}" Style="{StaticResource HelperText}"/>

                <Border x:Name="BehindNotice" Style="{StaticResource WarningNoticeStyle}" Visibility="Collapsed" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock x:Name="BehindText" TextWrapping="Wrap"/>
                        <Button x:Name="UpdateFromMainButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="UpdateFromMain_Click"
                                AutomationProperties.HelpText="{x:Static res:Strings.Submit_UpdateFromMainHelp}"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="PushNote" Style="{StaticResource HelperText}" Margin="0,10,0,10" Foreground="{StaticResource WarningBrush}"/>
                <Button x:Name="CreateButton" Content="{x:Static res:Strings.Submit_Create}" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" IsEnabled="False" Click="Create_Click"
                        AutomationProperties.Name="{x:Static res:Strings.Submit_Create}" AutomationProperties.HelpText="{x:Static res:Strings.Submit_CreateHelp}"/>
            </StackPanel>
        </Border>

        <Border x:Name="ChecksCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.Submit_Checks}" Style="{StaticResource CardTitle}" Margin="0"/>
                    <Button Grid.Column="1" Content="{x:Static res:Strings.Submit_CheckNow}" Style="{StaticResource LinkButton}" Click="CheckNow_Click" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Static res:Strings.Submit_CheckNow}"/>
                </Grid>
                <TextBlock x:Name="ChecksStatusText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
                <StackPanel x:Name="ChecksPanel" AutomationProperties.Name="{x:Static res:Strings.Submit_Checks}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</local:ScreenBase>
