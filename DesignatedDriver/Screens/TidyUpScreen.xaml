<local:ScreenBase x:Class="DesignatedDriver.Screens.TidyUpScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesignatedDriver.Screens"
        xmlns:res="clr-namespace:DesignatedDriver.Resources">
    <StackPanel MaxWidth="980" HorizontalAlignment="Left">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Tidy_Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{x:Static res:Strings.Tidy_Intro}" Style="{StaticResource PageIntro}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{x:Static res:Strings.Common_Refresh}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Margin="12,4,0,0" Click="Refresh_Click"
                    AutomationProperties.Name="{x:Static res:Strings.Common_Refresh}"/>
        </Grid>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Tidy_MainCard}" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="MainStatusText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                <Button x:Name="SwitchButton" Content="{x:Static res:Strings.Tidy_SwitchAndPull}" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" Click="SwitchAndPull_Click"
                        AutomationProperties.Name="{x:Static res:Strings.Tidy_SwitchAndPull}" AutomationProperties.HelpText="{x:Static res:Strings.Tidy_SwitchAndPullHelp}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Tidy_BranchesCard}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{x:Static res:Strings.Tidy_BranchesIntro}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                <StackPanel x:Name="BranchesPanel" AutomationProperties.Name="{x:Static res:Strings.Tidy_BranchesCard}"/>
                <TextBlock x:Name="NoBranchesText" Text="{x:Static res:Strings.Tidy_NoBranches}" Style="{StaticResource HelperText}" Visibility="Collapsed"/>
                <TextBlock Text="{x:Static res:Strings.Tidy_WhyForce}" Style="{StaticResource HelperText}" Margin="0,10,0,10"/>
                <Button x:Name="DeleteButton" Content="{x:Static res:Strings.Tidy_DeleteTicked}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" IsEnabled="False" Click="Delete_Click"
                        AutomationProperties.Name="{x:Static res:Strings.Tidy_DeleteTicked}" AutomationProperties.HelpText="{x:Static res:Strings.Tidy_DeleteHelp}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Tidy_PruneCard}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{x:Static res:Strings.Tidy_PruneIntro}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                <Button Content="{x:Static res:Strings.Tidy_Prune}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="Prune_Click"
                        AutomationProperties.Name="{x:Static res:Strings.Tidy_Prune}" AutomationProperties.HelpText="{x:Static res:Strings.Tidy_PruneIntro}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</local:ScreenBase>
