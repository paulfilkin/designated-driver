<local:ScreenBase x:Class="DesignatedDriver.Screens.FixProblemScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesignatedDriver.Screens"
        xmlns:res="clr-namespace:DesignatedDriver.Resources">
    <StackPanel MaxWidth="980" HorizontalAlignment="Left">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Fix_Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{x:Static res:Strings.Fix_Intro}" Style="{StaticResource PageIntro}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{x:Static res:Strings.Common_Refresh}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Margin="12,4,0,0" Click="Refresh_Click"
                    AutomationProperties.Name="{x:Static res:Strings.Common_Refresh}"/>
        </Grid>

        <!-- Where you are -->
        <Border x:Name="SituationNotice" Style="{StaticResource NoticeStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Fix_SituationCard}" FontWeight="SemiBold"/>
                <TextBlock x:Name="SituationText" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Border>

        <!-- 5. Conflict: first when it applies, because nothing else works until it is resolved -->
        <Border x:Name="ConflictCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Fix_ConflictCard}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{x:Static res:Strings.Fix_ConflictIntro}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Border Style="{StaticResource WarningNoticeStyle}">
                    <TextBlock Text="{x:Static res:Strings.Fix_ConflictMarkers}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"/>
                </Border>
                <StackPanel x:Name="ConflictFilesPanel" AutomationProperties.Name="{x:Static res:Strings.Fix_ConflictCard}"/>
                <TextBlock x:Name="NotAMergeText" Text="{x:Static res:Strings.Fix_NotAMerge}" Style="{StaticResource HelperText}" Margin="0,8,0,0" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{x:Static res:Strings.Fix_FinishMerge}" Style="{StaticResource ModernButton}" Click="FinishMerge_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Fix_FinishMerge}" AutomationProperties.HelpText="{x:Static res:Strings.Fix_FinishMergeHelp}"/>
                    <Button x:Name="AbortMergeButton" Content="{x:Static res:Strings.Fix_AbortMerge}" Style="{StaticResource DangerButton}" Click="AbortMerge_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Fix_AbortMerge}" AutomationProperties.HelpText="{x:Static res:Strings.Fix_AbortMergeHelp}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 1. Changes made on main (and a push refused as a protected branch) -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Fix_MoveCard}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{x:Static res:Strings.Fix_MoveIntro}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="MoveNote" Style="{StaticResource HelperText}" Margin="0,8,0,0"/>
                <StackPanel x:Name="MovePanel">
                    <TextBlock Text="{x:Static res:Strings.Fix_BranchNameLabel}" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="BranchNameBox" Style="{StaticResource ModernTextBox}" MaxWidth="480" HorizontalAlignment="Left" MinWidth="360" TextChanged="BranchNameBox_TextChanged"
                             AutomationProperties.Name="{x:Static res:Strings.Fix_BranchNameLabel}" AutomationProperties.HelpText="{x:Static res:Strings.Fix_BranchNameHint}"/>
                    <TextBlock Text="{x:Static res:Strings.Fix_BranchNameHint}" Style="{StaticResource HelperText}"/>
                    <Button x:Name="MoveButton" Content="{x:Static res:Strings.Fix_Move}" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="False" Click="Move_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Fix_Move}" AutomationProperties.HelpText="{x:Static res:Strings.Fix_MoveHelp}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 2. Throw changes away -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Fix_DiscardCard}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{x:Static res:Strings.Fix_DiscardIntro}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock x:Name="DiscardNone" Text="{x:Static res:Strings.Fix_DiscardNone}" Style="{StaticResource HelperText}" Visibility="Collapsed"/>
                <StackPanel x:Name="DiscardPanel">
                    <CheckBox x:Name="TickAllBox" Content="{x:Static res:Strings.Fix_TickAll}" Margin="0,0,0,6" Click="TickAll_Click" AutomationProperties.Name="{x:Static res:Strings.Fix_TickAll}"/>
                    <StackPanel x:Name="DiscardFilesPanel" AutomationProperties.Name="{x:Static res:Strings.Fix_DiscardCard}"/>
                    <Button x:Name="DiscardButton" Content="{x:Static res:Strings.Fix_Discard}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="False" Click="Discard_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Fix_Discard}" AutomationProperties.HelpText="{x:Static res:Strings.Fix_DiscardHelp}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3. Undo the last commit -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Fix_UndoCard}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{x:Static res:Strings.Fix_UndoIntro}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="UndoNote" Style="{StaticResource HelperText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <Button x:Name="UndoButton" Content="{x:Static res:Strings.Fix_Undo}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="False" Click="Undo_Click"
                        AutomationProperties.Name="{x:Static res:Strings.Fix_Undo}" AutomationProperties.HelpText="{x:Static res:Strings.Fix_UndoHelp}"/>
            </StackPanel>
        </Border>

        <!-- 4. Branch out of date with main -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Fix_BehindCard}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{x:Static res:Strings.Fix_BehindIntro}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="BehindNote" Style="{StaticResource HelperText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <Button x:Name="UpdateButton" Content="{x:Static res:Strings.Fix_UpdateWithPr}" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="False" Click="Update_Click"
                        AutomationProperties.Name="{x:Static res:Strings.Fix_UpdateWithPr}" AutomationProperties.HelpText="{x:Static res:Strings.Fix_UpdateWithPrHelp}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</local:ScreenBase>
