<local:ScreenBase x:Class="DesignatedDriver.Screens.StartWorkScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesignatedDriver.Screens"
        xmlns:res="clr-namespace:DesignatedDriver.Resources">
    <StackPanel MaxWidth="980" HorizontalAlignment="Left">
        <TextBlock Text="{x:Static res:Strings.StartWork_Title}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{x:Static res:Strings.StartWork_Intro}" Style="{StaticResource PageIntro}"/>

        <Border x:Name="DirtyNotice" Style="{StaticResource DangerNoticeStyle}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="DirtyText" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Static res:Strings.StartWork_DirtyOptions}" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{x:Static res:Strings.StartWork_GoToSaveAndShare}" Style="{StaticResource ModernButton}" Click="GoToSave_Click"
                            AutomationProperties.Name="{x:Static res:Strings.StartWork_GoToSaveAndShare}"/>
                    <Button Content="{x:Static res:Strings.StartWork_GoToFixProblem}" Style="{StaticResource SecondaryButton}" Click="GoToFix_Click"
                            AutomationProperties.Name="{x:Static res:Strings.StartWork_GoToFixProblem}"/>
                    <Button Content="{x:Static res:Strings.Common_Refresh}" Style="{StaticResource SecondaryButton}" Click="Refresh_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Common_Refresh}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.NewIssue_Card}" Style="{StaticResource CardTitle}" Margin="0"/>
                    <Button Grid.Column="1" x:Name="NewIssueToggle" Content="{x:Static res:Strings.NewIssue_Show}" Style="{StaticResource LinkButton}" Click="NewIssueToggle_Click" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Static res:Strings.NewIssue_Show}"/>
                </Grid>
                <TextBlock Text="{x:Static res:Strings.NewIssue_Intro}" Style="{StaticResource HelperText}" Margin="0,0,0,8"/>
                <StackPanel x:Name="NewIssuePanel" Visibility="Collapsed">
                    <!-- One radio button per choice: the repository's issue forms, or the built-in four (issue 88). -->
                    <WrapPanel x:Name="ChoicePanel" Margin="0,0,0,2"/>
                    <TextBlock x:Name="ChoiceSource" Style="{StaticResource HelperText}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock x:Name="ChoiceDescription" Style="{StaticResource HelperText}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <TextBlock Text="{x:Static res:Strings.NewIssue_TitleLabel}" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="IssueTitleBox" Style="{StaticResource ModernTextBox}" TextChanged="IssueField_TextChanged"
                             AutomationProperties.Name="{x:Static res:Strings.NewIssue_TitleLabel}" AutomationProperties.HelpText="{x:Static res:Strings.NewIssue_TitleHelp}"/>
                    <StackPanel x:Name="IssueFieldsPanel"/>
                    <TextBlock x:Name="NewIssueNote" Style="{StaticResource HelperText}" Margin="0,6,0,10"/>
                    <Button x:Name="CreateIssueButton" Content="{x:Static res:Strings.NewIssue_Create}" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" IsEnabled="False" Click="CreateIssue_Click"
                            AutomationProperties.Name="{x:Static res:Strings.NewIssue_Create}" AutomationProperties.HelpText="{x:Static res:Strings.NewIssue_CreateHelp}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="IssuesTitle" Text="{x:Static res:Strings.StartWork_ReadyIssues}" Style="{StaticResource CardTitle}" Margin="0"/>
                    <CheckBox Grid.Column="1" x:Name="ShowAllBox" Content="{x:Static res:Strings.StartWork_ShowAll}" Margin="12,0" VerticalAlignment="Center" Checked="ShowAll_Changed" Unchecked="ShowAll_Changed"
                              AutomationProperties.Name="{x:Static res:Strings.StartWork_ShowAll}" AutomationProperties.HelpText="{x:Static res:Strings.StartWork_ShowAllHelp}"/>
                    <Button Grid.Column="2" Content="{x:Static res:Strings.Common_Refresh}" Style="{StaticResource LinkButton}" Click="Refresh_Click" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Static res:Strings.Common_Refresh}"/>
                </Grid>
                <TextBlock x:Name="IssuesNote" Style="{StaticResource HelperText}" Margin="0,0,0,8"/>
                <ListBox x:Name="IssueList" MaxHeight="320" SelectionChanged="IssueList_SelectionChanged"
                         AutomationProperties.Name="{x:Static res:Strings.StartWork_ReadyIssues}" AutomationProperties.HelpText="{x:Static res:Strings.StartWork_IssueListHelp}"/>
                <TextBlock x:Name="EmptyText" Style="{StaticResource HelperText}" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- The picked issue, so what it asks for is read before a branch is made for it, as Review shows a picked pull
             request. Hidden until an issue is picked; a long body scrolls inside the card. -->
        <Border x:Name="IssueCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="IssueCardTitle" Style="{StaticResource CardTitle}" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Content="{x:Static res:Strings.Common_OpenOnGitHub}" Style="{StaticResource LinkButton}" VerticalAlignment="Top" Margin="12,0,0,0" Click="OpenIssue_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Common_OpenOnGitHub}"/>
                </Grid>
                <WrapPanel x:Name="IssueCardTags" Margin="0,0,0,4"/>
                <TextBlock x:Name="IssueCardOpened" Style="{StaticResource HelperText}" Margin="0,0,0,10"/>
                <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <ScrollViewer x:Name="IssueBodyScroller" MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="IssueBodyPanel" AutomationProperties.Name="{x:Static res:Strings.StartWork_IssueBody}"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.StartWork_BranchCard}" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="SelectedIssueText" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="{x:Static res:Strings.StartWork_BranchName}" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="BranchBox" Style="{StaticResource ModernTextBox}" FontFamily="Cascadia Mono, Consolas" TextChanged="BranchBox_TextChanged"
                         AutomationProperties.Name="{x:Static res:Strings.StartWork_BranchName}" AutomationProperties.HelpText="{x:Static res:Strings.StartWork_BranchNameHelp}"/>
                <TextBlock x:Name="BranchNote" Style="{StaticResource HelperText}"/>
                <TextBlock Text="{x:Static res:Strings.StartWork_WhatHappens}" Style="{StaticResource HelperText}" Margin="0,10,0,10"/>
                <Button x:Name="StartButton" Content="{x:Static res:Strings.StartWork_Start}" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" IsEnabled="False" Click="Start_Click"
                        AutomationProperties.Name="{x:Static res:Strings.StartWork_Start}" AutomationProperties.HelpText="{x:Static res:Strings.StartWork_WhatHappens}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</local:ScreenBase>
