<local:ScreenBase x:Class="DesignatedDriver.Screens.StatusScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesignatedDriver.Screens"
        xmlns:res="clr-namespace:DesignatedDriver.Resources">
    <StackPanel MaxWidth="980" HorizontalAlignment="Left">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Status_Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{x:Static res:Strings.Status_Intro}" Style="{StaticResource PageIntro}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{x:Static res:Strings.Common_Refresh}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Margin="12,4,0,0" Click="Refresh_Click"
                    AutomationProperties.Name="{x:Static res:Strings.Status_RefreshHelp}"/>
        </Grid>

        <Border x:Name="NoRepositoryNotice" Style="{StaticResource WarningNoticeStyle}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Status_NoRepository}"/>
                <Button Content="{x:Static res:Strings.Status_ChooseFolder}" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ChangeFolder_Click"
                        AutomationProperties.Name="{x:Static res:Strings.Status_ChooseFolder}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Status_Prerequisites}" Style="{StaticResource CardTitle}"/>
                <StackPanel x:Name="PrerequisitesPanel" AutomationProperties.Name="{x:Static res:Strings.Status_Prerequisites}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Status_Repository}" Style="{StaticResource CardTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Status_Folder}" Style="{StaticResource LabelText}" Margin="0,2,0,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FolderText" Style="{StaticResource MonoText}" VerticalAlignment="Center"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="{x:Static res:Strings.Status_Change}" Style="{StaticResource LinkButton}" Click="ChangeFolder_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Status_ChangeHelp}"/>
                    <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Status_GitHubRepository}" Style="{StaticResource LabelText}" Margin="0,2,0,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="OwnerRepoText" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="{x:Static res:Strings.Status_SignedInAs}" Style="{StaticResource LabelText}" Margin="0,2,0,2"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UserRoleText" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Text="{x:Static res:Strings.Status_Convention}" Style="{StaticResource LabelText}" Margin="0,2,0,2"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ConventionText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="CheckLink" Content="{x:Static res:Strings.Status_CheckLink}" Style="{StaticResource LinkButton}" Margin="12,0,0,0" Click="CheckLink_Click" Visibility="Collapsed" AutomationProperties.Name="{x:Static res:Strings.Status_CheckLinkHelp}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="4" Text="{x:Static res:Strings.Status_Board}" Style="{StaticResource LabelText}" Margin="0,2,0,2"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="BoardText" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Status_Automation}" Style="{StaticResource CardTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Status_Dependabot}" Style="{StaticResource LabelText}" Margin="0,2,0,2"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="DependabotText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="AlertsLink" Content="{x:Static res:Strings.Status_OpenAlerts}" Style="{StaticResource LinkButton}" Margin="12,0,0,0" Click="AlertsLink_Click" Visibility="Collapsed" AutomationProperties.Name="{x:Static res:Strings.Status_OpenAlerts}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Status_Actions}" Style="{StaticResource LabelText}" Margin="0,2,0,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ActionsText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <!-- What puts new issues and pull requests on the board, and the way to Auto-add when nothing does (issue 67). -->
                    <TextBlock Grid.Row="2" Text="{x:Static res:Strings.Status_BoardFeed}" Style="{StaticResource LabelText}" Margin="0,2,0,2"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="BoardFeedText" TextWrapping="Wrap"/>
                        <Button x:Name="AutoAddLink" Content="{x:Static res:Strings.Status_OpenBoardWorkflows}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                Click="AutoAddLink_Click" Visibility="Collapsed"
                                AutomationProperties.Name="{x:Static res:Strings.Status_OpenBoardWorkflows}" AutomationProperties.HelpText="{x:Static res:Strings.Status_OpenBoardWorkflowsHelp}"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ActionsNote" Style="{StaticResource HelperText}" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="AddMissingButton" Content="{x:Static res:Strings.Status_AddMissing}" Style="{StaticResource SecondaryButton}" Click="AddMissing_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Status_AddMissing}" AutomationProperties.HelpText="{x:Static res:Strings.Status_AddMissingHelp}"/>
                    <Button x:Name="TokenButton" Content="{x:Static res:Strings.Status_SetToken}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Token_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Status_SetToken}" AutomationProperties.HelpText="{x:Static res:Strings.Status_SetTokenHelp}"/>
                </StackPanel>
                <TextBlock Text="{x:Static res:Strings.Status_AutomationHelp}" Style="{StaticResource HelperText}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Status_Capabilities}" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="CapabilitiesLine" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <StackPanel x:Name="CapabilitiesPanel" AutomationProperties.Name="{x:Static res:Strings.Status_Capabilities}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Status_Branch}" Style="{StaticResource CardTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Status_CurrentBranch}" Style="{StaticResource LabelText}" Margin="0,2,0,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BranchText" Style="{StaticResource MonoText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Status_UncommittedChanges}" Style="{StaticResource LabelText}" Margin="0,2,0,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ChangesText" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="{x:Static res:Strings.Status_AgainstMain}" Style="{StaticResource LabelText}" Margin="0,2,0,2"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AheadBehindText" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Status_MyPullRequests}" Style="{StaticResource CardTitle}"/>
                <StackPanel x:Name="PullRequestsPanel" AutomationProperties.Name="{x:Static res:Strings.Status_MyPullRequests}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Status_MyIssues}" Style="{StaticResource CardTitle}"/>
                <StackPanel x:Name="IssuesPanel" AutomationProperties.Name="{x:Static res:Strings.Status_MyIssues}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</local:ScreenBase>
