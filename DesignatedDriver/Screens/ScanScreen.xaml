<local:ScreenBase x:Class="DesignatedDriver.Screens.ScanScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesignatedDriver.Screens"
        xmlns:res="clr-namespace:DesignatedDriver.Resources">
    <StackPanel MaxWidth="980" HorizontalAlignment="Left">
        <TextBlock Text="{x:Static res:Strings.Scan_Title}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{x:Static res:Strings.Scan_Intro}" Style="{StaticResource PageIntro}"/>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Scan_TargetCard}" Style="{StaticResource CardTitle}"/>

                <!-- No fixed accessible name: the option is announced with its text, which LoadAsync fills in. -->
                <RadioButton x:Name="CurrentOption" GroupName="Target" Margin="0,2,0,6" Checked="Target_Changed"/>

                <RadioButton x:Name="FolderOption" GroupName="Target" Content="{x:Static res:Strings.Scan_TargetFolder}" Margin="0,2,0,4" Checked="Target_Changed"
                             AutomationProperties.Name="{x:Static res:Strings.Scan_TargetFolder}"/>
                <Grid Margin="24,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Style="{StaticResource ModernTextBox}" TextChanged="FolderBox_TextChanged"
                             AutomationProperties.Name="{x:Static res:Strings.Scan_TargetFolder}" AutomationProperties.HelpText="{x:Static res:Strings.Scan_FolderHelp}"/>
                    <Button Grid.Column="1" Content="{x:Static res:Strings.Settings_Browse}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Browse_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Settings_BrowseHelp}"/>
                </Grid>
                <TextBlock Text="{x:Static res:Strings.Scan_FolderHelp}" Style="{StaticResource HelperText}" Margin="24,0,0,10"/>

                <RadioButton x:Name="NameOption" GroupName="Target" Content="{x:Static res:Strings.Scan_TargetName}" Margin="0,2,0,4" Checked="Target_Changed"
                             AutomationProperties.Name="{x:Static res:Strings.Scan_TargetName}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource ModernTextBox}" Width="360" HorizontalAlignment="Left" Margin="24,0,0,4" TextChanged="NameBox_TextChanged"
                         AutomationProperties.Name="{x:Static res:Strings.Scan_TargetName}" AutomationProperties.HelpText="{x:Static res:Strings.Scan_NameHelp}"/>
                <TextBlock Text="{x:Static res:Strings.Scan_NameHelp}" Style="{StaticResource HelperText}" Margin="24,0,0,12"/>

                <Button x:Name="ScanButton" Content="{x:Static res:Strings.Scan_Run}" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" Click="Scan_Click"
                        AutomationProperties.Name="{x:Static res:Strings.Scan_Run}" AutomationProperties.HelpText="{x:Static res:Strings.Scan_RunHelp}"/>
            </StackPanel>
        </Border>

        <Border x:Name="ResultCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.Scan_ResultCard}" Style="{StaticResource CardTitle}"/>
                    <Button Grid.Column="1" Content="{x:Static res:Strings.Scan_CopyReport}" Style="{StaticResource LinkButton}" VerticalAlignment="Top" Click="Copy_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Scan_CopyReportHelp}"/>
                </Grid>
                <TextBlock x:Name="ScannedText" Style="{StaticResource HelperText}" Margin="0,0,0,8"/>
                <Border x:Name="VerdictNotice" Style="{StaticResource NoticeStyle}">
                    <StackPanel>
                        <TextBlock x:Name="VerdictText" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock x:Name="SummaryText" Margin="0,4,0,0"/>
                        <TextBlock x:Name="NextStepText" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <!-- The ways on from the verdict as real buttons, so the next step is where the eye lands. Each has a line
                     beside it saying what it does, on screen as well as for screen readers, and the buttons share a width. -->
                <StackPanel x:Name="ActionRow" Margin="0,10,0,0" Grid.IsSharedSizeScope="True">
                    <!-- A scan by name that found a clone beside the known ones: scanning that folder comes first. -->
                    <Grid x:Name="ScanCloneChoice" Margin="0,0,0,8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ChoiceButton"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ScanCloneButton" Content="{x:Static res:Strings.Scan_ScanNearbyClone}" Style="{StaticResource ModernButton}" Click="ScanClone_Click"
                                AutomationProperties.Name="{x:Static res:Strings.Scan_ScanNearbyClone}"/>
                        <TextBlock x:Name="ScanCloneText" Grid.Column="1" Style="{StaticResource HelperText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    <Grid x:Name="SetUpChoice" Margin="0,0,0,8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ChoiceButton"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SetUpButton" Content="{x:Static res:Strings.Scan_SetUp}" Style="{StaticResource ModernButton}" Click="SetUp_Click"
                                AutomationProperties.Name="{x:Static res:Strings.Scan_SetUp}" AutomationProperties.HelpText="{x:Static res:Strings.Scan_SetUpHelp}"/>
                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Scan_SetUpHelp}" Style="{StaticResource HelperText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    <Grid x:Name="OpenCheckChoice" Margin="0,0,0,8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ChoiceButton"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="OpenCheckButton" Content="{x:Static res:Strings.Scan_OpenCheck}" Style="{StaticResource ModernButton}" Click="OpenCheck_Click"
                                AutomationProperties.Name="{x:Static res:Strings.Scan_OpenCheck}" AutomationProperties.HelpText="{x:Static res:Strings.Scan_OpenCheckHelp}"/>
                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Scan_OpenCheckHelp}" Style="{StaticResource HelperText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    <!-- Add the clone, clone it, or mark its entry: the label and the line are set with the route (ScanReportText.AsItIsButton). -->
                    <Grid x:Name="AsItIsChoice" Margin="0,0,0,8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ChoiceButton"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AsItIsButton" Style="{StaticResource SecondaryButton}" Click="AsItIs_Click"/>
                        <TextBlock x:Name="AsItIsText" Grid.Column="1" Style="{StaticResource HelperText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
                <StackPanel x:Name="FindingsPanel" AutomationProperties.Name="{x:Static res:Strings.Scan_ResultCard}" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Border>
    </StackPanel>
</local:ScreenBase>
