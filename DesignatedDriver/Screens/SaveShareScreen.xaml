<local:ScreenBase x:Class="DesignatedDriver.Screens.SaveShareScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesignatedDriver.Screens"
        xmlns:res="clr-namespace:DesignatedDriver.Resources">
    <StackPanel MaxWidth="980" HorizontalAlignment="Left">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Save_Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{x:Static res:Strings.Save_Intro}" Style="{StaticResource PageIntro}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{x:Static res:Strings.Common_Refresh}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Margin="12,4,0,0" Click="Refresh_Click"
                    AutomationProperties.Name="{x:Static res:Strings.Common_Refresh}"/>
        </Grid>

        <Border x:Name="OnMainNotice" Style="{StaticResource WarningNoticeStyle}" Visibility="Collapsed">
            <TextBlock x:Name="OnMainText"/>
        </Border>

        <!-- Changed files -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock x:Name="FilesTitle" Text="{x:Static res:Strings.Save_ChangedFiles}" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="BranchLine" Style="{StaticResource HelperText}" Margin="0,0,0,8"/>
                <StackPanel x:Name="FilesPanel" AutomationProperties.Name="{x:Static res:Strings.Save_ChangedFiles}"/>
                <TextBlock x:Name="NoFilesText" Text="{x:Static res:Strings.Save_NoChanges}" Style="{StaticResource HelperText}" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Self-test -->
        <Border x:Name="SelfTestCard" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Save_SelfTest}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{x:Static res:Strings.Save_SelfTestIntro}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                <TextBlock x:Name="SelfTestCommandText" Style="{StaticResource MonoText}" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,10"/>
                <Button x:Name="RunSelfTestButton" Content="{x:Static res:Strings.Save_RunSelfTest}" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" Click="RunSelfTest_Click"
                        AutomationProperties.Name="{x:Static res:Strings.Save_RunSelfTest}" AutomationProperties.HelpText="{x:Static res:Strings.Save_SelfTestIntro}"/>
                <ListBox x:Name="SelfTestList" MaxHeight="260" Margin="0,12,0,0" Visibility="Collapsed" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                         AutomationProperties.Name="{x:Static res:Strings.Save_SelfTestResults}"/>
                <TextBlock x:Name="SelfTestSummary" Margin="0,8,0,0" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Commit -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Save_Commit}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{x:Static res:Strings.Save_CommitIntro}" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.Save_Summary}" Style="{StaticResource LabelText}"/>
                    <TextBlock Grid.Column="1" x:Name="SummaryCount" Style="{StaticResource HelperText}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                </Grid>
                <TextBox x:Name="SummaryBox" Style="{StaticResource ModernTextBox}" TextChanged="Message_TextChanged" MaxLines="1"
                         AutomationProperties.Name="{x:Static res:Strings.Save_Summary}" AutomationProperties.HelpText="{x:Static res:Strings.Save_SummaryHelp}"/>
                <TextBlock Text="{x:Static res:Strings.Save_Detail}" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="DetailBox" Style="{StaticResource MultilineTextBox}" Height="110" TextChanged="Message_TextChanged"
                         AutomationProperties.Name="{x:Static res:Strings.Save_Detail}" AutomationProperties.HelpText="{x:Static res:Strings.Save_DetailHelp}"/>
                <StackPanel x:Name="ChecksPanel" Margin="0,8,0,4" AutomationProperties.Name="{x:Static res:Strings.Save_MessageChecks}" AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="CommitButton" Content="{x:Static res:Strings.Save_CommitAll}" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" Margin="0,8,0,0" IsEnabled="False" Click="Commit_Click"
                        AutomationProperties.Name="{x:Static res:Strings.Save_CommitAll}" AutomationProperties.HelpText="{x:Static res:Strings.Save_CommitAllHelp}"/>
            </StackPanel>
        </Border>

        <!-- Push -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Save_Push}" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="PushStatusText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                <Button x:Name="PushButton" Content="{x:Static res:Strings.Save_PushButton}" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" IsEnabled="False" Click="Push_Click"
                        AutomationProperties.Name="{x:Static res:Strings.Save_PushButton}" AutomationProperties.HelpText="{x:Static res:Strings.Save_PushHelp}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</local:ScreenBase>
