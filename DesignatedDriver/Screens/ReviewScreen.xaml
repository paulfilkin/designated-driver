<local:ScreenBase x:Class="DesignatedDriver.Screens.ReviewScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesignatedDriver.Screens"
        xmlns:res="clr-namespace:DesignatedDriver.Resources">
    <StackPanel MaxWidth="980" HorizontalAlignment="Left">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Review_Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{x:Static res:Strings.Review_Intro}" Style="{StaticResource PageIntro}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{x:Static res:Strings.Common_Refresh}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Margin="12,4,0,0" Click="Refresh_Click"
                    AutomationProperties.Name="{x:Static res:Strings.Common_Refresh}"/>
        </Grid>

        <Border x:Name="NotAdminNotice" Style="{StaticResource WarningNoticeStyle}" Visibility="Collapsed">
            <TextBlock x:Name="NotAdminText"/>
        </Border>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Review_ListCard}" Style="{StaticResource CardTitle}"/>
                <ListBox x:Name="PullRequestList" BorderThickness="0" Background="Transparent" SelectionChanged="PullRequestList_SelectionChanged"
                         HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Static res:Strings.Review_ListCard}"/>
                <TextBlock x:Name="NoPullRequestsText" Text="{x:Static res:Strings.Review_NoPullRequests}" Style="{StaticResource HelperText}" Visibility="Collapsed"/>
                <TextBlock x:Name="NeedsUpdateText" Style="{StaticResource HelperText}" Foreground="{StaticResource WarningBrush}" Visibility="Collapsed" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="SelectPromptText" Text="{x:Static res:Strings.Review_SelectPrompt}" Style="{StaticResource HelperText}"/>
            </StackPanel>
        </Border>

        <Border x:Name="DetailCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DetailTitle" Style="{StaticResource CardTitle}" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Content="{x:Static res:Strings.Common_OpenOnGitHub}" Style="{StaticResource LinkButton}" VerticalAlignment="Top" Click="OpenOnGitHub_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Common_OpenOnGitHub}"/>
                </Grid>
                <WrapPanel x:Name="DetailTags" Margin="0,0,0,8"/>
                <TextBlock x:Name="WhyText" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>

                <TextBlock Text="{x:Static res:Strings.Review_FilesCard}" Style="{StaticResource LabelText}"/>
                <TextBlock x:Name="FilesSummary" Style="{StaticResource HelperText}" Margin="0,0,0,4"/>
                <StackPanel x:Name="FilesPanel" AutomationProperties.Name="{x:Static res:Strings.Review_FilesCard}"/>

                <!-- Review -->
                <TextBlock Text="{x:Static res:Strings.Review_ReviewSection}" Style="{StaticResource LabelText}" Margin="0,16,0,4"/>
                <TextBlock x:Name="OwnNote" Text="{x:Static res:Strings.Review_OwnCantApprove}" Style="{StaticResource HelperText}" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,6" Visibility="Collapsed"/>
                <TextBlock Text="{x:Static res:Strings.Review_CommentLabel}" Style="{StaticResource HelperText}" Margin="0,0,0,4"/>
                <TextBox x:Name="CommentBox" Style="{StaticResource MultilineTextBox}" Height="80" TextChanged="CommentBox_TextChanged"
                         AutomationProperties.Name="{x:Static res:Strings.Review_CommentLabel}" AutomationProperties.HelpText="{x:Static res:Strings.Review_CommentHelp}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="ApproveButton" Content="{x:Static res:Strings.Review_Approve}" Style="{StaticResource ModernButton}" Click="Approve_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Review_Approve}" AutomationProperties.HelpText="{x:Static res:Strings.Review_ApproveHelp}"/>
                    <Button x:Name="RequestChangesButton" Content="{x:Static res:Strings.Review_RequestChanges}" Style="{StaticResource SecondaryButton}" Click="RequestChanges_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Review_RequestChanges}" AutomationProperties.HelpText="{x:Static res:Strings.Review_RequestChangesHelp}"/>
                </StackPanel>

                <!-- Merge -->
                <TextBlock Text="{x:Static res:Strings.Review_MergeSection}" Style="{StaticResource LabelText}" Margin="0,16,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="MergeButton" Content="{x:Static res:Strings.Review_Merge}" Style="{StaticResource ModernButton}" Click="Merge_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Review_Merge}" AutomationProperties.HelpText="{x:Static res:Strings.Review_MergeHelp}"/>
                    <Button x:Name="UpdateBranchButton" Content="{x:Static res:Strings.Review_UpdateBranch}" Style="{StaticResource SecondaryButton}" Click="UpdateBranch_Click" Visibility="Collapsed"
                            AutomationProperties.Name="{x:Static res:Strings.Review_UpdateBranch}" AutomationProperties.HelpText="{x:Static res:Strings.Review_UpdateBranchHelp}"/>
                </StackPanel>

                <!-- Bypass: only when the rules block the merge or the pull request is the user's own -->
                <!-- In place of the bypass card when the repository's settings turn the bypass off (issue 74). -->
                <TextBlock x:Name="BypassOffText" Text="{x:Static res:Strings.Review_BypassOff}" Style="{StaticResource HelperText}" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed"/>
                <Border x:Name="BypassPanel" Style="{StaticResource DangerNoticeStyle}" Margin="0,16,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Review_BypassCard}" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Static res:Strings.Review_BypassIntro}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock x:Name="BypassOwnText" Text="{x:Static res:Strings.Review_BypassOwn}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                        <TextBlock Text="{x:Static res:Strings.Review_ReasonLabel}" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="ReasonBox" Style="{StaticResource MultilineTextBox}" Height="70" TextChanged="ReasonBox_TextChanged"
                                 AutomationProperties.Name="{x:Static res:Strings.Review_ReasonLabel}" AutomationProperties.HelpText="{x:Static res:Strings.Review_ReasonHelp}"/>
                        <Button x:Name="BypassButton" Content="{x:Static res:Strings.Review_Bypass}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="False" Click="Bypass_Click"
                                AutomationProperties.Name="{x:Static res:Strings.Review_Bypass}" AutomationProperties.HelpText="{x:Static res:Strings.Review_BypassHelp}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</local:ScreenBase>
