<local:ScreenBase x:Class="DesignatedDriver.Screens.RepositoriesScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesignatedDriver.Screens"
        xmlns:res="clr-namespace:DesignatedDriver.Resources">
    <StackPanel MaxWidth="980" HorizontalAlignment="Left">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Repos_Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{x:Static res:Strings.Repos_Intro}" Style="{StaticResource PageIntro}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{x:Static res:Strings.Common_Refresh}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Margin="12,4,0,0" Click="Refresh_Click"
                    AutomationProperties.Name="{x:Static res:Strings.Common_Refresh}"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="{x:Static res:Strings.Repos_Add}" Style="{StaticResource ModernButton}" Click="Add_Click"
                    AutomationProperties.Name="{x:Static res:Strings.Repos_Add}" AutomationProperties.HelpText="{x:Static res:Strings.Repos_AddHelp}"/>
            <Button x:Name="CloneButton" Content="{x:Static res:Strings.Repos_Clone}" Style="{StaticResource SecondaryButton}" Click="Clone_Click"
                    AutomationProperties.Name="{x:Static res:Strings.Repos_Clone}" AutomationProperties.HelpText="{x:Static res:Strings.Repos_CloneHelp}"/>
            <Button Content="{x:Static res:Strings.Repos_Wizard}" Style="{StaticResource SecondaryButton}" Click="Wizard_Click"
                    AutomationProperties.Name="{x:Static res:Strings.Repos_Wizard}" AutomationProperties.HelpText="{x:Static res:Strings.Repos_WizardHelp}"/>
            <Button Content="{x:Static res:Strings.Nav_Scan}" Style="{StaticResource SecondaryButton}" Click="Scan_Click"
                    AutomationProperties.Name="{x:Static res:Strings.Nav_Scan}" AutomationProperties.HelpText="{x:Static res:Strings.Scan_Intro}"/>
        </StackPanel>

        <!-- Clone a repository that already exists and add it as it is: only git clone and gh reads run. -->
        <Border x:Name="CloneCard" Style="{StaticResource CardStyle}" Visibility="Collapsed" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Clone_Title}" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="{x:Static res:Strings.Clone_Intro}" Style="{StaticResource HelperText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="{x:Static res:Strings.Clone_Name}" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="CloneNameBox" Style="{StaticResource ModernTextBox}" AutomationProperties.Name="{x:Static res:Strings.Clone_Name}"/>
                <TextBlock Text="{x:Static res:Strings.Clone_Parent}" Style="{StaticResource LabelText}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CloneParentBox" Style="{StaticResource ModernTextBox}" AutomationProperties.Name="{x:Static res:Strings.Clone_Parent}" AutomationProperties.HelpText="{x:Static res:Strings.Clone_ParentHelp}"/>
                    <Button Grid.Column="1" Content="{x:Static res:Strings.Settings_Browse}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="CloneBrowse_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Settings_BrowseHelp}"/>
                </Grid>
                <TextBlock Text="{x:Static res:Strings.Clone_ParentHelp}" Style="{StaticResource HelperText}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="CloneGoButton" Content="{x:Static res:Strings.Clone_Go}" Style="{StaticResource ModernButton}" Click="CloneGo_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Clone_Go}" AutomationProperties.HelpText="{x:Static res:Strings.Clone_Intro}"/>
                    <Button Content="{x:Static res:Strings.Clone_Cancel}" Style="{StaticResource SecondaryButton}" Click="CloneCancel_Click"
                            AutomationProperties.Name="{x:Static res:Strings.Clone_Cancel}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.Repos_Filter}" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="FilterBox" Style="{StaticResource ModernTextBox}" TextChanged="Filter_Changed"
                     AutomationProperties.Name="{x:Static res:Strings.Repos_Filter}" AutomationProperties.HelpText="{x:Static res:Strings.Repos_FilterHelp}"/>
            <CheckBox Grid.Column="2" x:Name="StarredBox" Content="{x:Static res:Strings.Repos_StarredOnly}" Margin="14,0,0,0" VerticalAlignment="Center" Checked="Starred_Changed" Unchecked="Starred_Changed"
                      AutomationProperties.Name="{x:Static res:Strings.Repos_StarredOnly}" AutomationProperties.HelpText="{x:Static res:Strings.Repos_StarredOnlyHelp}"/>
        </Grid>
        <TextBlock x:Name="FilterNote" Style="{StaticResource HelperText}" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <StackPanel x:Name="ListPanel" AutomationProperties.Name="{x:Static res:Strings.Repos_Title}"/>
                <TextBlock x:Name="NoneText" Text="{x:Static res:Strings.Repos_None}" Style="{StaticResource HelperText}" Visibility="Collapsed"/>
                <TextBlock x:Name="NoMatchText" Text="{x:Static res:Strings.Repos_NoneMatch}" Style="{StaticResource HelperText}" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </StackPanel>
</local:ScreenBase>
